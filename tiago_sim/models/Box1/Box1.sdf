<?xml version="1.0" ?><sdf version="1.6">

<model name="Box1">

  <static>false</static>

    <link name="Aruco_box">

    <!-- Box (10cm cube) -->
      <visual name="Box">
        <pose>0.0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.1 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.7 0.7 0.7 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <collision name="Box_collision">
        <pose>0.0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.1 0.1</size>
          </box>
        </geometry>
      </collision>

      <!-- ArUco on front face (-X), facing the approaching robot -->
     <visual name="Front">
        <pose>-0.051 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/Box1.dae</uri>
            <scale>0.1 0.1 0.1</scale>
          </mesh>
        </geometry>
      </visual>

  <inertial>
    <mass value="0.5"/>
    <inertia ixx="0.001633333" ixy="0.0" ixz="0.0" iyy="0.001633333" iyz="0.0" izz="0.001633333"/>
  </inertial>

  </link>
  </model>

</sdf>
