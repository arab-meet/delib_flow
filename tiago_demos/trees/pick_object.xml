<root BTCPP_format="4">
  <BehaviorTree ID="MainTree">
    <RetryUntilSuccessful num_attempts="3">
      <SequenceWithMemory>
        <Script code=" head_action:='head_controller/follow_joint_trajectory'; arm_action:='arm_controller/follow_joint_trajectory'; gripper_action:='gripper_controller/follow_joint_trajectory'; torso_action:='torso_controller/follow_joint_trajectory'"/>
        <GetTrajectoryFromYAML package_name="tiago_grab" config_file="tiago_positions.yaml"/>

        <!-- Open gripper before searching -->
        <FollowJointTrajectory action_name="{gripper_action}" name="Open Gripper" trajectory="{traj.grip_open}"/>

        <!-- Search for ArUco: sweep head through positions until marker is found -->
        <Fallback>
          <Sequence>
            <FollowJointTrajectory action_name="{head_action}" name="Look center slight" trajectory="{traj.head_search_center_slight}"/>
            <SetTargetUsingTransform name="GetArUcoTarget" offset_z="0.0" target_pose="{grab_goal}"/>
          </Sequence>
          <Sequence>
            <FollowJointTrajectory action_name="{head_action}" name="Look center down" trajectory="{traj.head_search_center_down}"/>
            <SetTargetUsingTransform name="GetArUcoTarget" offset_z="0.0" target_pose="{grab_goal}"/>
          </Sequence>
          <Sequence>
            <FollowJointTrajectory action_name="{head_action}" name="Look left down" trajectory="{traj.head_search_left_down}"/>
            <SetTargetUsingTransform name="GetArUcoTarget" offset_z="0.0" target_pose="{grab_goal}"/>
          </Sequence>
          <Sequence>
            <FollowJointTrajectory action_name="{head_action}" name="Look right down" trajectory="{traj.head_search_right_down}"/>
            <SetTargetUsingTransform name="GetArUcoTarget" offset_z="0.0" target_pose="{grab_goal}"/>
          </Sequence>
          <Sequence>
            <FollowJointTrajectory action_name="{head_action}" name="Look center more down" trajectory="{traj.head_search_center_more_down}"/>
            <SetTargetUsingTransform name="GetArUcoTarget" offset_z="0.0" target_pose="{grab_goal}"/>
          </Sequence>
          <Sequence>
            <FollowJointTrajectory action_name="{head_action}" name="Look left more down" trajectory="{traj.head_search_left_more_down}"/>
            <SetTargetUsingTransform name="GetArUcoTarget" offset_z="0.0" target_pose="{grab_goal}"/>
          </Sequence>
          <Sequence>
            <FollowJointTrajectory action_name="{head_action}" name="Look right more down" trajectory="{traj.head_search_right_more_down}"/>
            <SetTargetUsingTransform name="GetArUcoTarget" offset_z="0.0" target_pose="{grab_goal}"/>
          </Sequence>
        </Fallback>

        <!-- Approach: drive forward so the object is within arm reach -->
        <ComputeApproachPose object_pose="{grab_goal}" reach_distance="0.85" approach_distance="{approach_dist}"/>
        <DriveOnHeading name="ApproachObject" dist_to_travel="{approach_dist}" speed="0.25" time_allowance="20"/>

        <!-- Re-detect ArUco from close range for precise positioning -->
        <Fallback>
          <Sequence>
            <FollowJointTrajectory action_name="{head_action}" name="Look center slight" trajectory="{traj.head_search_center_slight}"/>
            <SetTargetUsingTransform name="GetArUcoTarget" offset_z="0.0" target_pose="{grab_goal}"/>
          </Sequence>
          <Sequence>
            <FollowJointTrajectory action_name="{head_action}" name="Look center down" trajectory="{traj.head_search_center_down}"/>
            <SetTargetUsingTransform name="GetArUcoTarget" offset_z="0.0" target_pose="{grab_goal}"/>
          </Sequence>
          <Sequence>
            <FollowJointTrajectory action_name="{head_action}" name="Look left down" trajectory="{traj.head_search_left_down}"/>
            <SetTargetUsingTransform name="GetArUcoTarget" offset_z="0.0" target_pose="{grab_goal}"/>
          </Sequence>
          <Sequence>
            <FollowJointTrajectory action_name="{head_action}" name="Look right down" trajectory="{traj.head_search_right_down}"/>
            <SetTargetUsingTransform name="GetArUcoTarget" offset_z="0.0" target_pose="{grab_goal}"/>
          </Sequence>
          <Sequence>
            <FollowJointTrajectory action_name="{head_action}" name="Look center more down" trajectory="{traj.head_search_center_more_down}"/>
            <SetTargetUsingTransform name="GetArUcoTarget" offset_z="0.0" target_pose="{grab_goal}"/>
          </Sequence>
          <Sequence>
            <FollowJointTrajectory action_name="{head_action}" name="Look left more down" trajectory="{traj.head_search_left_more_down}"/>
            <SetTargetUsingTransform name="GetArUcoTarget" offset_z="0.0" target_pose="{grab_goal}"/>
          </Sequence>
          <Sequence>
            <FollowJointTrajectory action_name="{head_action}" name="Look right more down" trajectory="{traj.head_search_right_more_down}"/>
            <SetTargetUsingTransform name="GetArUcoTarget" offset_z="0.0" target_pose="{grab_goal}"/>
          </Sequence>
        </Fallback>

        <!-- Raise torso before picking -->
        <FollowJointTrajectory action_name="{torso_action}" name="Raise torso" trajectory="{traj.torso_up}"/>

        <!-- Extend arm to pre-grasp position (joints away from limits for feasible MoveIt planning) -->
        <FollowJointTrajectory action_name="{arm_action}" name="Arm pre-grasp" trajectory="{traj.arm_pre_grasp}"/>

        <!-- Pick Object -->
        <Sequence>
          <ComputeTopDownGrasp object_pose="{grab_goal}" grasp_offset="0.05" pregrasp_offset="0.05" pregrasp="{pregrasp_pose}" grasp="{grasp_pose}"/>

          <ComputePlanToTargetIK name="Plan to pre-grasp pose" target_ik="{pregrasp_pose}" trajectory="{trajectory_msg}"/>
          <FollowJointTrajectory action_name="{arm_action}" name="Move to pre-grasp pose" trajectory="{trajectory_msg}"/>

          <ComputePlanToTargetIK name="Plan to grasp pose" target_ik="{grasp_pose}" trajectory="{trajectory_msg}"/>
          <FollowJointTrajectory action_name="{arm_action}" name="Move to grasp pose" trajectory="{trajectory_msg}"/>
        </Sequence>
        <FollowJointTrajectory action_name="{gripper_action}" name="Close Gripper" trajectory="{traj.grip_close}"/>

        <!-- Lift with object -->
        <FollowJointTrajectory action_name="{arm_action}" trajectory="{traj.arm_ready_to_grab}"/>

      </SequenceWithMemory>
    </RetryUntilSuccessful>
  </BehaviorTree>
</root>
