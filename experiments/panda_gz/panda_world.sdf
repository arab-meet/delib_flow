<?xml version="1.0"?>
<sdf version="1.9">
  <world name="panda_world">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <gravity>0 0 -9.81</gravity>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><direction>-0.5 0.1 -0.9</direction></light>
    <model name="ground"><static>true</static><link name="l">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
    </link></model>
    <model name="table"><static>true</static><pose>0.45 0 0.05 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.5 0.7 0.1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.5 0.7 0.1</size></box></geometry></visual>
    </link></model>
    <model name="cube"><pose>0.4 0 0.125 0 0 0</pose><link name="cube_link">
      <inertial><mass>0.05</mass><inertia><ixx>2.1e-5</ixx><iyy>2.1e-5</iyy><izz>2.1e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
      <visual name="v"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></visual>
    </link></model>
  </world>
</sdf>
