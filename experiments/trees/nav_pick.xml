<root BTCPP_format="4">
  <BehaviorTree ID="MainTree">
    <Sequence>
      <Script code=" head_action:='head_controller/follow_joint_trajectory'; arm_action:='arm_controller/follow_joint_trajectory'; gripper_action:='gripper_controller/follow_joint_trajectory'; torso_action:='torso_controller/follow_joint_trajectory'"/>
      <GetTrajectoryFromYAML package_name="tiago_grab" config_file="tiago_positions.yaml"/>
      <FollowJointTrajectory action_name="{arm_action}" name="ArmReady" trajectory="{traj.arm_ready_to_grab}"/>
      <NavigateToPose name="ToAway" goal="{loc.Away}"/>
      <NavigateToPose name="ToTable" goal="{loc.AtTable}"/>
      <FollowJointTrajectory action_name="{head_action}" name="HeadDown" trajectory="{traj.head_down}"/>
      <FollowJointTrajectory action_name="{gripper_action}" name="Open Gripper" trajectory="{traj.grip_open}"/>
      <Wait wait_duration="2.0"/>
      <SetTargetUsingTransform name="GetArUcoTarget" offset_z="0.0" target_pose="{grab_goal}"/>
      <ComputeTopDownGrasp object_pose="{grab_goal}" grasp_offset="0.32" pregrasp_offset="0.05" pregrasp="{pregrasp_pose}" grasp="{grasp_pose}"/>
      <ComputePlanToTargetIK name="Plan to pre-grasp pose" target_ik="{pregrasp_pose}" trajectory="{trajectory_msg}"/>
      <FollowJointTrajectory action_name="{arm_action}" name="Move to pre-grasp pose" trajectory="{trajectory_msg}"/>
      <ComputePlanToTargetIK name="Plan to grasp pose" target_ik="{grasp_pose}" trajectory="{trajectory_msg}"/>
      <FollowJointTrajectory action_name="{arm_action}" name="Move to grasp pose" trajectory="{trajectory_msg}"/>
      <FollowJointTrajectory action_name="{gripper_action}" name="Close Gripper" trajectory="{traj.grip_close}"/>
      <Wait wait_duration="1.0"/>
      <FollowJointTrajectory action_name="{torso_action}" name="TorsoUp" trajectory="{traj.torso_up}"/>
      <FollowJointTrajectory action_name="{arm_action}" name="ArmCarry" trajectory="{traj.arm_ready_to_grab}"/>
    </Sequence>
  </BehaviorTree>
</root>
